{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RARVIS-Lighthouse Companion",
  "version": "0.2.0",
  "identifier": "com.rarvis.lighthouse.companion",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "capabilities": [
        "companion-readonly-default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "RARVIS-Lighthouse Companion (Read-Only)",
        "width": 1080,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "companionGuardrails": {
    "readOnlyEnforced": true,
    "directDbWriteButtons": false,
    "outboundNetworkAllowed": false,
    "allowedIpcCommands": [
      "companion_describe",
      "companion_refresh",
      "companion_snapshot",
      "companion_export_handoff"
    ],
    "forbiddenPermissions": [
      "shell:allow-execute",
      "shell:allow-spawn",
      "shell:allow-open",
      "http:default",
      "http:allow-fetch",
      "fs:allow-write",
      "fs:allow-remove",
      "sql:allow-execute"
    ],
    "forbiddenCrates": [
      "reqwest",
      "ureq",
      "hyper",
      "tokio-tungstenite",
      "tauri-plugin-http",
      "tauri-plugin-shell",
      "tauri-plugin-updater"
    ],
    "licensePolicy": "Apache-2.0 Clean-Room (No AGPL-3.0)"
  }
}
